{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "groupName": "Control Plane Dependencies",
      "matchPaths": ["apps/api/**", "services/**", "packages/**"]
    },
    {
      "matchPackagePatterns": ["*"],
      "groupName": "Web Frontend Dependencies",
      "matchPaths": ["apps/web/**"]
    },
    {
      "matchPackagePatterns": ["*"],
      "groupName": "Runtime Dependencies",
      "matchPaths": ["runtimes/**"]
    }
  ]
}
