# --- Secrets & local configuration ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Runtime data (user volumes, never committed) ---
data/
data/*.json
!apps/web/src/data/
apps/web/src/data/*
!apps/web/src/data/mockData.ts
!apps/web/src/data/taskQuestions.ts
!apps/web/src/data/frameworkRuns.ts
logs/
*.log
spool/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / TypeScript ---
node_modules/
.pnpm-store/
*.tsbuildinfo
package-lock.json
.vite/
.turbo/
playwright-report/
test-results/

# --- Generated artifacts ---
runtimes/*/docs-index/
sbom/

# Lockfiles are committed (uv.lock, pnpm-lock.yaml); npm's package-lock.json
# is excluded above because this repo is a pnpm workspace.

# --- Editors & OS ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Local agent tooling ---
.taste-skill/
docs/plans/taste-skill/

# --- Asset bundles: only the README-trackable PNGs are committed ---
images/*
!images/AFA-10-GitHub-Visuals/
images/AFA-10-GitHub-Visuals/*
!images/AFA-10-GitHub-Visuals/*.png

# --- Working design prototypes (exploration only, not part of the product) ---
design-agents/

# --- Working reports (kept out of the repo, folder exists via .gitkeep) ---
temp-dosyalar/*
!temp-dosyalar/raporlar/
temp-dosyalar/raporlar/*
!temp-dosyalar/raporlar/.gitkeep
