# Environment configuration for Agentic Arena
ARENA_ENV=development
ARENA_PORT=8000
ARENA_HOST=127.0.0.1
ARENA_LOG_LEVEL=INFO

# --- Benchmark Model Gateway (read by services/model_gateway/src/arena_gateway/runtime.py) ---
# Transports: "openai" (default, /chat/completions endpoint) or "opencode"
# (ivmeX/OpenCode server; the API key is the server password).
# When ARENA_PROVIDER_API_KEY is set, workers execute their LLM steps against this
# provider; otherwise they fall back to the offline MockProvider.
ARENA_PROVIDER_API_KEY=
ARENA_PROVIDER_TRANSPORT=openai
ARENA_PROVIDER_BASE_URL=https://api.openai.com/v1
ARENA_MODEL_ID=gpt-4o-mini
# OpenCode transport extras (optional):
# ARENA_PROVIDER_OPENCODE_USER=opencode
# ARENA_PROVIDER_OPENCODE_PROVIDER_ID=genel

# --- Task Design (read by apps/api/src/arena_api/task_design.py) ---
ARENA_DESIGN_MODEL=
ARENA_DESIGN_API_KEY=
ARENA_DESIGN_TRANSPORT=openai
ARENA_DESIGN_BASE_URL=https://api.openai.com/v1

# --- Control plane state (read by apps/api/src/arena_api/main.py) ---
# Defaults to ./data/arena_state.json when unset; set empty to disable persistence.
# ARENA_STATE_FILE=./data/arena_state.json

# Security
ARENA_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ARENA_DATA_DIR=./data

# PostgreSQL
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena_secret
POSTGRES_DB=agentic_arena
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://arena:arena_secret@127.0.0.1:5432/agentic_arena

# Telemetry & OTel
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
ARENA_TELEMETRY_ENABLED=true
