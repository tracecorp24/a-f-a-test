{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-arena.org/schemas/task-spec.json",
  "title": "TaskSpec",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "input_mode": {
      "type": "string",
      "enum": ["natural_language", "visual_flow", "code_import"]
    },
    "task": {
      "type": "object",
      "properties": {
        "objective": { "type": "string" },
        "output_schema_ref": { "type": ["string", "null"] },
        "language": { "type": "string", "default": "en" },
        "required_steps": { "type": "array", "items": { "type": "string" } },
        "free_design": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["objective"]
    },
    "model": {
      "type": "object",
      "properties": {
        "connection_ref": { "type": "string" },
        "model_id": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0, "default": 0.2 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "default": 4096 },
        "fallback": { "type": "string", "enum": ["disabled"], "default": "disabled" }
      },
      "required": ["connection_ref", "model_id"]
    },
    "frameworks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "comparison_mode": {
      "type": "string",
      "enum": ["native"],
      "default": "native"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "dataset_ref": { "type": "string" },
        "tools_allowlist": { "type": "array", "items": { "type": "string" } },
        "internet": { "type": "boolean", "default": false }
      },
      "required": ["dataset_ref"]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "policy": { "type": "string", "enum": ["required", "preferred", "free", "not_applicable"] },
          "evaluator": { "type": "string" },
          "threshold": { "type": ["number", "boolean", "string", "null"] },
          "max_seconds": { "type": ["number", "null"] },
          "direction": { "type": "string", "enum": ["minimize", "maximize"] }
        },
        "required": ["id", "policy"]
      }
    },
    "experiment": {
      "type": "object",
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1, "default": 1 },
        "execution_order": { "type": "string", "default": "sequential_interleaved" },
        "independent_sessions": { "type": "boolean", "default": true },
        "build_budget_per_framework": {
          "type": "object",
          "properties": {
            "max_attempts": { "type": "integer", "default": 3 },
            "max_tokens": { "type": "integer", "default": 60000 },
            "max_seconds": { "type": "integer", "default": 1200 }
          }
        },
        "runtime_budget_per_run": {
          "type": "object",
          "properties": {
            "max_calls": { "type": "integer", "default": 40 },
            "max_tokens": { "type": "integer", "default": 100000 },
            "watchdog_seconds": { "type": "integer", "default": 600 }
          }
        },
        "seed_policy": { "type": "string", "default": "fixed_if_supported" }
      }
    },
    "ranking": {
      "type": "object",
      "properties": {
        "weights": {
          "type": "object",
          "properties": {
            "quality": { "type": "number", "minimum": 0 },
            "speed": { "type": "number", "minimum": 0 },
            "token": { "type": "number", "minimum": 0 },
            "reliability": { "type": "number", "minimum": 0 }
          }
        },
        "min_quality": { "type": "number", "default": 0 }
      }
    }
  },
  "required": ["schema_version", "project_id", "revision", "input_mode", "task", "model", "frameworks", "inputs", "criteria"],
  "additionalProperties": false
}
