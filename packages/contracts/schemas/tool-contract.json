{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-arena.org/schemas/tool-contract.json",
  "title": "ToolContract",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema_ref": {
      "type": ["string", "null"]
    },
    "permission": {
      "type": "string"
    },
    "deterministic": {
      "type": "boolean",
      "default": true
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["name", "version", "description", "input_schema", "permission", "timeout_ms"],
  "additionalProperties": false
}
